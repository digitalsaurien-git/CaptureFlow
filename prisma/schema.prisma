generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Capture {
  id         String        @id @default(cuid())
  title      String
  content    String?
  source     String?
  status     CaptureStatus @default(INBOX)
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum CaptureStatus {
  INBOX
  TODO
  DONE
  ARCHIVED
}

enum ProgressStep {
  P0
  P20
  P40
  P60
  P80
  P100
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  DOING
  DONE
  ARCHIVED
}

enum TrainingStatus {
  ACTIVE
  ARCHIVED
}

enum TrainingItemStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  progress    ProgressStep  @default(P0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks       Task[]
  notes       Note[]

  @@index([status])
  @@index([createdAt])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  progress    ProgressStep @default(P0)
  position    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes       Note[]

  @@index([projectId])
  @@index([status])
  @@index([position])
}

model Note {
  id             String        @id @default(cuid())
  content        String
  projectId      String?
  taskId         String?
  trainingId     String?
  trainingItemId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  training       Training?     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  trainingItem   TrainingItem? @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([trainingId])
  @@index([trainingItemId])
  @@index([createdAt])
}

model Training {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      TrainingStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       TrainingItem[]
  notes       Note[]

  @@index([status])
  @@index([createdAt])
}

model TrainingItem {
  id              String       @id @default(cuid())
  trainingId      String
  title           String
  durationMinutes Int
  status          TrainingItemStatus @default(ACTIVE)
  progress        ProgressStep @default(P0)
  isDone          Boolean      @default(false)
  position        Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  training        Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  notes           Note[]

  @@index([trainingId])
  @@index([status])
  @@index([position])
  @@index([isDone])
}
